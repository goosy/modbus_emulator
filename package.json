{
	"name": "modbus_emulator",
	"version": "0.1.0",
	"description": "Modbus device emulator: slave services (TCP, RTU over TCP, RTU) over structured data blocks",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"default": "./dist/modbus_emulator.js"
		}
	},
	"files": [
		"dist",
		"src/index.d.ts"
	],
	"engines": {
		"node": ">=20.11"
	},
	"dependencies": {
		"es-modbus": "^0.3.0-beta.2",
		"layout-data": "0.2.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"eslint": "10.12.0",
		"globals": "17.13.0",
		"rolldown": "^1.2.12",
		"yaml": "^2.9.1"
	},
	"scripts": {
		"build": "rolldown -c",
		"test": "pnpm build && node --test",
		"lint": "eslint .",
		"prepare": "pnpm build"
	},
	"keywords": [
		"modbus",
		"modbusTCP",
		"modbusRTU",
		"emulator",
		"simulator"
	],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@12.5.1"
}
