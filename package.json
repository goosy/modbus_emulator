{
	"name": "modbus-emulator",
	"version": "0.2.0",
	"description": "Modbus device emulator: slave services (TCP, RTU over TCP, RTU) over structured data blocks",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=20.11"
	},
	"dependencies": {
		"es-modbus": "0.3.0-beta.4",
		"layout-data": "0.6.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"eslint": "10.12.0",
		"globals": "17.13.0",
		"rolldown": "1.2.15"
	},
	"scripts": {
		"build": "rolldown -c",
		"test": "pnpm build && node --test && pnpm test:dist",
		"test:dist": "node --test --import ./test/dist.js",
		"lint": "eslint .",
		"prepare": "pnpm build"
	},
	"keywords": [
		"modbus",
		"modbusTCP",
		"modbusRTU",
		"emulator",
		"simulator"
	],
	"author": "Goosy Jo <goosy.jo@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/goosy/modbus_emulator.git"
	},
	"license": "MPL-2.0",
	"packageManager": "pnpm@12.5.1"
}
